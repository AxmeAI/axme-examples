{
  "scenario_id": "human.cli_tasks.v1",
  "title": "Human via axme tasks CLI — approve/reject from terminal",
  "description": "Intent is sent to a human participant. The runner prints instructions to run axme tasks list and axme tasks approve <id>. Tests GET /v1/me/tasks endpoint and CLI task commands.",

  "agents": [
    {
      "role": "checker",
      "address": "pre-check-agent",
      "display_name": "Pre-check Agent",
      "delivery_mode": "internal",
      "handler": {
        "type": "auto_complete",
        "delay_seconds": 0.8,
        "outcome": { "result": "pre_check_passed" }
      },
      "description": "step 1/2 — auto: runs pre-checks"
    }
  ],

  "humans": [
    {
      "role": "reviewer",
      "display_name": "Code Reviewer",
      "description": "step 2/2 — human: review via CLI (axme tasks approve)",
      "handler": { "type": "human_cli_hint" }
    }
  ],

  "workflow_steps": [
    {
      "step_id": "pre_check",
      "tool_id": "tool.approval.check_window",
      "assigned_to": "checker",
      "step_deadline_seconds": 60
    },
    {
      "step_id": "review",
      "tool_id": "tool.approval.human_signoff",
      "assigned_to": "reviewer",
      "requires_approval": true,
      "step_deadline_seconds": 7200,
      "remind_after_seconds": 900,
      "remind_interval_seconds": 900,
      "max_reminders": 4,
      "human_task": {
        "task_type": "review",
        "title": "Code review: feature/payment-refactor",
        "description": "Review the PR and approve or request changes.",
        "allowed_outcomes": ["approved", "changes_requested", "rejected"],
        "required_comment": false,
        "form_schema": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["approved", "changes_requested", "rejected"]
            },
            "comment": { "type": "string" }
          }
        }
      }
    }
  ],

  "intent": {
    "type": "intent.approval.code_review.v1",
    "payload": {
      "pr_id":      "PR-4422",
      "repository": "axme-control-plane",
      "branch":     "feature/payment-refactor",
      "author":     "alice@example.com",
      "files_changed": 14
    }
  },

  "durability": {
    "deadline_minutes": 240,
    "max_delivery_attempts": 3
  }
}
