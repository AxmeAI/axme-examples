{
  "scenario_id": "human.email_magic_link.v1",
  "title": "Human via email magic link — one-click approval",
  "description": "Full end-to-end human task flow. Gateway sends an email with a magic link when intent.human_task_assigned fires. The human clicks the link (or the runner shows the token URL). One-time action token calls POST /v1/tasks/action to resume the intent.",

  "agents": [
    {
      "role": "validator",
      "address": "policy-validator",
      "display_name": "Policy Validator",
      "delivery_mode": "internal",
      "handler": {
        "type": "auto_complete",
        "delay_seconds": 1.0,
        "outcome": { "result": "policy_ok" }
      },
      "description": "step 1/2 — auto: validates policy before routing to human"
    }
  ],

  "humans": [
    {
      "role": "approver",
      "display_name": "Security Approver",
      "description": "step 2/2 — human: approve or reject via email magic link",
      "handler": { "type": "interactive" }
    }
  ],

  "workflow_steps": [
    {
      "step_id": "validate_policy",
      "tool_id": "tool.approval.check_window",
      "assigned_to": "validator",
      "step_deadline_seconds": 60
    },
    {
      "step_id": "human_approval",
      "tool_id": "tool.approval.human_signoff",
      "assigned_to": "approver",
      "requires_approval": true,
      "step_deadline_seconds": 3600,
      "remind_after_seconds": 600,
      "remind_interval_seconds": 600,
      "max_reminders": 3,
      "human_task": {
        "task_type": "approval",
        "title": "Access grant approval",
        "description": "Review and approve the access request. A magic link was sent to your email.",
        "allowed_outcomes": ["approved", "rejected"],
        "required_comment": false,
        "form_schema": {
          "type": "object",
          "required": ["approved"],
          "properties": {
            "approved": { "type": "boolean" },
            "notes":    { "type": "string" }
          }
        }
      }
    }
  ],

  "intent": {
    "type": "intent.approval.access_mgmt.v1",
    "payload": {
      "request_id":    "ITSM-9001",
      "resource":      "prod-secrets-manager",
      "access_type":   "READ",
      "requestor":     "svc:deploy-pipeline",
      "justification": "CI/CD pipeline needs to read deployment secrets"
    }
  },

  "durability": {
    "deadline_minutes": 120,
    "max_delivery_attempts": 3
  }
}
