{
  "scenario_id": "human.form_validation.v1",
  "title": "Human structured form — task_result validated against form_schema",
  "description": "Human task with a complex form_schema (multiple required fields, enums, string lengths). Tests that the gateway validates task_result on resume: wrong data → 422, correct data → COMPLETED. The runner first submits invalid data to show the rejection, then submits valid data.",

  "agents": [],

  "humans": [
    {
      "role": "analyst",
      "display_name": "Risk Analyst",
      "description": "step 1/1 — human: fills a structured risk assessment form",
      "handler": { "type": "interactive" }
    }
  ],

  "workflow_steps": [
    {
      "step_id": "risk_assessment_form",
      "tool_id": "tool.approval.human_signoff",
      "assigned_to": "analyst",
      "requires_approval": true,
      "step_deadline_seconds": 7200,
      "human_task": {
        "task_type": "provide_data",
        "title": "Risk assessment — infrastructure change #CHG-5500",
        "description": "Complete the structured risk assessment form. All required fields must be filled.",
        "allowed_outcomes": ["submitted", "cannot_assess"],
        "required_comment": false,
        "form_schema": {
          "type": "object",
          "required": ["outcome", "risk_level", "blast_radius", "rollback_available"],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["submitted", "cannot_assess"]
            },
            "risk_level": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"]
            },
            "blast_radius": {
              "type": "string",
              "enum": ["single_service", "multiple_services", "full_platform"]
            },
            "rollback_available": {
              "type": "boolean"
            },
            "rollback_plan": {
              "type": "string",
              "maxLength": 500
            },
            "estimated_downtime_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "notes": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      }
    }
  ],

  "intent": {
    "type": "intent.approval.risk_assessment.v1",
    "payload": {
      "change_id":   "CHG-5500",
      "service":     "payment-gateway",
      "change_type": "database_migration",
      "description": "Migrate payment_events table to partitioned schema"
    }
  },

  "durability": {
    "deadline_minutes": 120,
    "max_delivery_attempts": 3
  }
}
