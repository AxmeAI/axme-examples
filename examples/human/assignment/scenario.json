{
  "scenario_id": "human.assignment.v1",
  "title": "Assignment — designate incident commander for P1",
  "description": "A single-step human task. The intent goes directly to agent_core which routes it to the on-call manager to assign an incident commander.",

  "agents": [],

  "humans": [
    {
      "role": "oncall_manager",
      "display_name": "On-Call Manager"
    }
  ],

  "workflow": {
    "steps": [
      {
        "step_id": "assign_commander",
        "tool_id": "tool.approval.human_signoff",
        "assigned_to": "oncall_manager",
        "requires_approval": true,
        "step_deadline_seconds": 86400,
        "human_task": {
          "title": "Assign incident commander",
          "description": "Incident INC-2026-1847 classified as P1 affecting payment-api. Please designate an incident commander.",
          "task_type": "assignment",
          "allowed_outcomes": ["assigned", "declined"],
          "notify_email": "oncall@example.com",
          "form_schema": {
            "type": "object",
            "required": ["assignee"],
            "properties": {
              "assignee": {
                "type": "string",
                "description": "Email of the designated incident commander"
              },
              "priority": {
                "type": "string",
                "description": "Override priority level",
                "enum": ["P1", "P2", "P3", "P4"]
              }
            }
          }
        }
      }
    ]
  },

  "intent": {
    "type": "intent.incident.assignment.v1",
    "payload": {
      "incident_id": "INC-2026-1847",
      "severity": "P1",
      "service": "payment-api"
    }
  }
}
